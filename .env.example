# Public dashboard: use HTTPS reverse proxy, firewall and strong credentials.
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8088
DASHBOARD_USERNAME=admin
# Generate using: python -m app.password_hash
DASHBOARD_PASSWORD_HASH=
# Generate using: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Frontend/backend/review: openai, codex, anthropic, claude, ollama, litellm,
# omniroute, openrouter or custom. Codex uses the OpenAI API and API billing.
# Set MODEL explicitly, or MODEL=auto and list FREE_MODELS; local Ollama can autodiscover.
FRONTEND_PROVIDER=openai
FRONTEND_API_URL=
FRONTEND_API_KEY=
FRONTEND_MODEL=gpt-4.1-mini
FRONTEND_FREE_MODELS=
BACKEND_PROVIDER=openai
BACKEND_API_URL=
BACKEND_API_KEY=
BACKEND_MODEL=gpt-4.1-mini
BACKEND_FREE_MODELS=
REVIEW_PROVIDER=openai
REVIEW_API_URL=
REVIEW_API_KEY=
REVIEW_MODEL=gpt-4.1-mini
REVIEW_FREE_MODELS=
# Poll a single explicitly authorized GitHub repository for completed failed workflows.
# Creates local repair jobs only; no unattended push, PR, merge or deployment.
GITHUB_MONITOR_ENABLED=false
GITHUB_MONITOR_REPO=NekoSuneVR/TriAgent-Studio
GITHUB_MONITOR_TOKEN=
GITHUB_POLL_SECONDS=180
MAX_AGENT_STEPS=18
MAX_OUTPUT_TOKENS=3000
MAX_TASKS_PER_DAY=20

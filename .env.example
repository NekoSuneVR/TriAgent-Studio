# Generate a random strong dashboard token. Use HTTPS reverse proxy or an SSH tunnel.
DASHBOARD_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8088
# OpenAI-compatible API settings for each worker. Keys never appear in the browser.
FRONTEND_API_URL=https://api.openai.com/v1
FRONTEND_API_KEY=
FRONTEND_MODEL=gpt-4.1-mini
BACKEND_API_URL=https://api.openai.com/v1
BACKEND_API_KEY=
BACKEND_MODEL=gpt-4.1-mini
REVIEW_API_URL=https://api.openai.com/v1
REVIEW_API_KEY=
REVIEW_MODEL=gpt-4.1-mini
MAX_AGENT_STEPS=18
MAX_OUTPUT_TOKENS=3000
MAX_TASKS_PER_DAY=20
